{
  "manifest_version": 3,
  "name": "Pinterest LocalBoard",
  "version": "1.1.0",
  "description": "Pinterest LocalBoard downloads every image visible in the current Pinterest board in the highest quality the page exposes and bundles everything into a ZIP.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Pinterest LocalBoard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://pinterest.com/*",
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pinterest.com/*",
        "https://*.pinterest.com/*"
      ],
      "js": [
        "vendor/jszip.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
